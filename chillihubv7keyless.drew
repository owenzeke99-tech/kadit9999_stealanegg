        setclipboard(GET_KEY_URL)
        showStatus("🔗 Get key link copied to clipboard!", Color3.fromRGB(20, 35, 50), Color3.fromRGB(100, 200, 255), Color3.fromRGB(120, 215, 255))
    else
        showStatus("❌ Your executor does not support clipboard.", Color3.fromRGB(50, 20, 25), Color3.fromRGB(255, 75, 75), Color3.fromRGB(255, 100, 100))
    end
end)
