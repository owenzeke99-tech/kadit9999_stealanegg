-- Hiệu ứng Hover mượt mà cho nút
local function applyHoverEffect(btn)
    local originalSize = btn.Size
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = originalSize + UDim2.new(0, 4, 0, 2)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = originalSize}):Play()
    end)
end

applyHoverEffect(CheckButton)
applyHoverEffect(GetKeyButton)

