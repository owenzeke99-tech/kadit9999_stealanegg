local StatusLabel = Instance.new("TextLabel")
StatusLabel.Name = "StatusLabel"
StatusLabel.Parent = StatusFrame
StatusLabel.BackgroundTransparency = 1.00
StatusLabel.Size = UDim2.new(1, 0, 1, 0)
StatusLabel.Font = Enum.Font.GothamBold
StatusLabel.Text = ""
StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
StatusLabel.TextSize = 12

local function showStatus(text, bgColor, borderColor, textColor)
    StatusFrame.Visible = true
    StatusFrame.BackgroundColor3 = bgColor
    StatusStroke.Color = borderColor
    StatusLabel.TextColor3 = textColor
    StatusLabel.Text = text
    
    StatusFrame.Size = UDim2.new(0.81, 0, 0, 30)
    StatusFrame.BackgroundTransparency = 0.8
    TweenService:Create(StatusFrame, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0.85, 0, 0, 36),
        BackgroundTransparency = 0.35
    }):Play()
end

-- Hiệu ứng lắc menu đồng bộ (Shake Animation)
local originalPos = MainFrame.Position
local function shakeUI()
    local p = MainFrame.Position
    local info = TweenInfo.new(0.03, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    
    TweenService:Create(MainFrame, info, {Position = p + UDim2.new(0, -12, 0, 0)}):Play()
    task.wait(0.03)
    TweenService:Create(MainFrame, info, {Position = p + UDim2.new(0, 12, 0, 0)}):Play()
    task.wait(0.03)
    TweenService:Create(MainFrame, info, {Position = p + UDim2.new(0, -8, 0, 0)}):Play()
    task.wait(0.03)
    TweenService:Create(MainFrame, info, {Position = p + UDim2.new(0, 8, 0, 0)}):Play()
    task.wait(0.03)
    TweenService:Create(MainFrame, info, {Position = p}):Play()
end

-- Xử lý sự kiện nút bấm
CheckButton.MouseButton1Click:Connect(function()
    local enteredKey = TextBox.Text
    if enteredKey == CORRECT_KEY then
        showStatus("✨ Success! Loading script...", Color3.fromRGB(20, 50, 30), Color3.fromRGB(80, 255, 120), Color3.fromRGB(100, 255, 140))
        saveKey()
        task.wait(0.8)
        ScreenGui:Destroy()
        loadstring(game:HttpGet(TARGET_SCRIPT_URL))()
    else
        -- Đồng thời: Xóa chữ ngay lập tức, bật bảng thông báo lỗi và lắc menu
        TextBox.Text = "" 
        showStatus("⚡ Incorrect Key! Access Denied.", Color3.fromRGB(50, 20, 25), Color3.fromRGB(255, 75, 75), Color3.fromRGB(255, 100, 100))
        task.spawn(shakeUI)
    end
end)

GetKeyButton.MouseButton1Click:Connect(function()
